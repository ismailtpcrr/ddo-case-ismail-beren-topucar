# ParaKöprü — ortam değişkenleri
# Kullanım: cp .env.example .env
#
# Buradaki değerler yalnız yerel demo içindir; gerçek bir ortamda hepsi değiştirilmelidir.
# docker-compose.yml bu dosyayı okur. Servisler arası adresler (ör. veritabanı host'u)
# compose içinde verilir, burada tekrar edilmez.

# --- Veritabanı (PostgreSQL 16) ---
# Kullanıcı adları ve parolalar compose'da bağlantı adresinin (postgres://kullanıcı:parola@...) içine yazılır;
# bu yüzden yalnız harf, rakam ve - _ . karakterlerinden oluşmalıdır.
POSTGRES_DB=parakopru
# Sahip rol: tabloları oluşturur ve migrasyonları çalıştırır.
POSTGRES_USER=parakopru_owner
POSTGRES_PASSWORD=owner-dev-password
# Uygulama rolü: api ve worker bununla bağlanır.
# Defter ve denetim tablolarında yalnız INSERT/SELECT yetkisi vardır.
APP_DB_USER=parakopru_app
APP_DB_PASSWORD=app-dev-password

# --- Kimlik doğrulama ---
# JWT imza anahtarı (en az 32 karakter).
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
# Refresh çerezi yalnız HTTPS'te gönderilsin mi? Yerel demo http://localhost üzerinde çalıştığı için false;
# HTTPS arkasındaki gerçek bir ortamda true olmalı.
COOKIE_SECURE=false
# Altı demo hesabın ortak parolası (README ve TESTING.md'de listelenir).
DEMO_PASSWORD=ParaKopru.2026

# --- Genel ---
# debug | info | warn | error
LOG_LEVEL=info

# --- Simülatör ---
# Aynı tohum her çalıştırmada aynı veriyi üretir.
SIM_SEED=20261026
SIM_CUSTOMERS=20000
SIM_DAILY_TRANSACTIONS=200000
# Dış banka sahtesi (şartname: %20 hata, %10 çift cevap).
BANK_FAILURE_PERCENT=20
BANK_DUPLICATE_PERCENT=10
